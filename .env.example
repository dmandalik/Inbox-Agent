# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env`.
#     cp .env.example .env
# Every secret is read from the environment; nothing is hardcoded in the code.

# --- Triage backend -------------------------------------------------------
# stub = deterministic keyword/sender rules. No key, no network. (What CI runs.)
# llm  = zero-shot classification via the LLM below. Needs a free key.
TRIAGE_BACKEND=llm

# --- LLM (any OpenAI-compatible endpoint) ---------------------------------
# Switching providers is a .env edit, never a code change.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-free-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Other presets — swap the three values above for any of these:
#
#   Google AI Studio (free tier):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-2.5-flash
#
#   Local Ollama (offline, no real key — any placeholder works):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=qwen3:8b
#     LLM_API_KEY=ollama

# --- Storage --------------------------------------------------------------
# SQLite lives under git-ignored var/ so it can never be committed.
DB_PATH=var/inbox.db

# --- Gmail (OPTIONAL, read-only, never required to run) -------------------
# Paths to files YOU provide. Both stay in git-ignored var/.
GMAIL_CREDENTIALS_PATH=var/credentials.json
GMAIL_TOKEN_PATH=var/token.json
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.readonly
